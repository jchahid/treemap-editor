{
  "name": "treemap-editor",
  "version": "2.0.0",
  "main": "main.js",
  "scripts": {
    "ng": "ng",
    "start": "node scripts/set-env.js && ng serve",
    "build": "node scripts/set-env.js && ng build --base-href ./",
    "watch": "node scripts/set-env.js && ng build --watch --configuration development",
    "electron": "node scripts/set-env.js && ng build --base-href ./ && electron .",
    "electron:build": "node scripts/set-env.js && ng build --base-href ./ && electron-builder",
    "build:web": "ng build --configuration production"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^17.0.0",
    "@angular/common": "^17.0.0",
    "@angular/compiler": "^17.0.0",
    "@angular/core": "^17.0.0",
    "@angular/forms": "^17.0.0",
    "@angular/platform-browser": "^17.0.0",
    "@angular/platform-browser-dynamic": "^17.0.0",
    "@angular/router": "^17.3.12",
    "firebase": "^12.13.0",
    "rxjs": "~7.8.0",
    "tailwindcss": "^3.4.19",
    "tslib": "^2.3.0",
    "zone.js": "~0.14.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^17.0.0",
    "@angular/cli": "^17.0.0",
    "@angular/compiler-cli": "^17.0.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "typescript": "~5.2.0"
  },
  "build": {
    "appId": "com.treemap.editor",
    "productName": "TreeMapEditor",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/treemap-editor/**/*",
      "main.js",
      "package.json"
    ],
    "win": {
      "target": "portable"
    }
  }
}
